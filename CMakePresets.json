{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "default",
      "inherits": "base",
      "displayName": "Default (RelWithDebInfo, no sanitizer)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "AddressSanitizer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "INFERSCHED_SANITIZER": "address"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "displayName": "ThreadSanitizer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "INFERSCHED_SANITIZER": "thread"
      }
    },
    {
      "name": "llama-cuda",
      "inherits": "base",
      "displayName": "Real-model backend: llama.cpp + CUDA (Release)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "INFERSCHED_WITH_LLAMA": "ON",
        "INFERSCHED_LLAMA_CUDA": "ON",
        "CMAKE_CUDA_ARCHITECTURES": "native"
      }
    },
    {
      "name": "llama-cpu",
      "inherits": "base",
      "displayName": "Real-model backend: llama.cpp on CPU (tests and CI)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "INFERSCHED_WITH_LLAMA": "ON",
        "INFERSCHED_LLAMA_CUDA": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "llama-cuda", "configurePreset": "llama-cuda" },
    { "name": "llama-cpu", "configurePreset": "llama-cpu" }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "llama-cpu",
      "configurePreset": "llama-cpu",
      "output": { "outputOnFailure": true }
    }
  ]
}
